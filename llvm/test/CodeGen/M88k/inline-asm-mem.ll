; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; Inline asm memory operands. A non-indirect "m" (or "rm", which selects the
; memory alternative) operand is spilled to a stack slot, and memory operands
; print as "%r0, %rN" like GCC.
;
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88100 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s

define i32 @rm(i32 %x) {
; CHECK-LABEL: rm:
; CHECK:       | %bb.0:
; CHECK-NEXT:    subu %r31, %r31, 8
; CHECK-NEXT:    add %r3, %r31, 4
; CHECK-NEXT:    st %r2, %r31, 4
; CHECK-NEXT:    |APP
; CHECK-NEXT:    ld %r2, %r0, %r3
; CHECK-NEXT:    |NO_APP
; CHECK-NEXT:    addu %r31, %r31, 8
; CHECK-NEXT:    jmp %r1
  %r = call i32 asm sideeffect "ld $0, $1", "=r,rm"(i32 %x)
  ret i32 %r
}

define void @m(ptr %p) {
; CHECK-LABEL: m:
; CHECK:       | %bb.0:
; CHECK-NEXT:    subu %r31, %r31, 8
; CHECK-NEXT:    add %r3, %r31, 4
; CHECK-NEXT:    st %r2, %r31, 4
; CHECK-NEXT:    |APP
; CHECK-NEXT:    st %r0, %r0, %r3
; CHECK-NEXT:    |NO_APP
; CHECK-NEXT:    addu %r31, %r31, 8
; CHECK-NEXT:    jmp %r1
  call void asm sideeffect "st %r0, $0", "m,~{memory}"(ptr %p)
  ret void
}

define i32 @indirect(ptr %p) {
; CHECK-LABEL: indirect:
; CHECK:       | %bb.0:
; CHECK-NEXT:    |APP
; CHECK-NEXT:    ld %r2, %r0, %r2
; CHECK-NEXT:    |NO_APP
; CHECK-NEXT:    jmp %r1
  %r = call i32 asm sideeffect "ld $0, $1", "=r,*m"(ptr elementtype(i32) %p)
  ret i32 %r
}
