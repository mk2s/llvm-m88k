; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; Integer arguments and results that are not 32 or 64 bits wide (i40, i52,
; i128) are passed in i64 parts (register pairs, then stack). The custom
; 64-bit argument code used to merge the parts straight into the odd-sized
; value ("input operands do not cover output register" assertion; invalid MIR
; in release builds), and i128 consumed the locations of one part only.
;
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88100 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s

define i52 @pass52(i52 %a, i32 %k, i52 %b) {
; CHECK-LABEL: pass52:
; CHECK:       | %bb.0:
; CHECK-NEXT:    addu.co %r3, %r3, %r7
; CHECK-NEXT:    addu.ci %r2, %r2, %r6
; CHECK-NEXT:    xor %r3, %r3, %r4
; CHECK-NEXT:    jmp %r1
  %s = add i52 %a, %b
  %kk = zext i32 %k to i52
  %r = xor i52 %s, %kk
  ret i52 %r
}

; Six i40 values: three in r4:r5, r6:r7, r8:r9 (r3 unused), the rest on the stack.
define i40 @pass40(i32 %x, i40 %a, i40 %b, i40 %c, i40 %d, i40 %e) {
; CHECK-LABEL: pass40:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ld.d %r2, %r31, 0
; CHECK-NEXT:    ld.d %r10, %r31, 8
; CHECK-NEXT:    addu.co %r5, %r5, %r7
; CHECK-NEXT:    addu.ci %r4, %r4, %r6
; CHECK-NEXT:    subu.co %r5, %r5, %r9
; CHECK-NEXT:    subu.ci %r4, %r4, %r8
; CHECK-NEXT:    addu.co %r5, %r5, %r3
; CHECK-NEXT:    addu.ci %r2, %r4, %r2
; CHECK-NEXT:    xor %r3, %r5, %r11
; CHECK-NEXT:    xor %r2, %r2, %r10
; CHECK-NEXT:    jmp %r1
  %1 = add i40 %a, %b
  %2 = sub i40 %1, %c
  %3 = add i40 %2, %d
  %4 = xor i40 %3, %e
  ret i40 %4
}

define i64 @call40(i40 %a) {
; CHECK-LABEL: call40:
; CHECK:       | %bb.0:
; CHECK-NEXT:    subu %r31, %r31, 32
; CHECK-NEXT:    st %r1, %r31, 20 | 4-byte Folded Spill
; CHECK-NEXT:    st %r30, %r31, 16 | 4-byte Folded Spill
; CHECK-NEXT:    addu %r30, %r31, 16
; CHECK-NEXT:    or %r5, %r0, %r3
; CHECK-NEXT:    or %r4, %r0, %r2
; CHECK-NEXT:    st.d %r4, %r31, 0
; CHECK-NEXT:    st.d %r4, %r31, 8
; CHECK-NEXT:    or %r2, %r0, 5
; CHECK-NEXT:    or %r7, %r0, %r5
; CHECK-NEXT:    or %r6, %r0, %r4
; CHECK-NEXT:    or %r9, %r0, 3
; CHECK-NEXT:    or %r8, %r0, 0
; CHECK-NEXT:    bsr pass40
; CHECK-NEXT:    and %r3, %r3, 65535
; CHECK-NEXT:    mask %r2, %r2, 255
; CHECK-NEXT:    ld %r30, %r31, 16 | 4-byte Folded Reload
; CHECK-NEXT:    ld %r1, %r31, 20 | 4-byte Folded Reload
; CHECK-NEXT:    addu %r31, %r31, 32
; CHECK-NEXT:    jmp %r1
  %r = call i40 @pass40(i32 5, i40 %a, i40 %a, i40 3, i40 %a, i40 %a)
  %z = zext i40 %r to i64
  ret i64 %z
}

; The first i64 part of the i128 is the most significant one.
define void @take128(i128 %a, ptr %p) {
; CHECK-LABEL: take128:
; CHECK:       | %bb.0:
; CHECK-NEXT:    st %r5, %r6, 12
; CHECK-NEXT:    st %r4, %r6, 8
; CHECK-NEXT:    st %r3, %r6, 4
; CHECK-NEXT:    st %r2, %r6, 0
; CHECK-NEXT:    jmp %r1
  store i128 %a, ptr %p, align 8
  ret void
}
