# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# Regression tests for instruction selection bugs found while building the
# compiler-rt builtins for the NCD 19c bare-metal target:
# - brcond_u*: G_BRCOND of an unsigned compare against zero hit
#   "Unexpected predicate" in getCCforBCOND. (udivsi3 at -O0)
# - implicit_def: G_IMPLICIT_DEF with an already constrained register class
#   could not be selected. (adddf3, udivmoddi4)
# - ptradd_first: G_PTR_ADD as the first instruction of a block crashed,
#   because the G_PTRTOINT was inserted before I.getPrevNode(), which is null.
#   (gcc_personality_v0)
# - zext_s1/sext_s1/anyext_s1/trunc_s1: extensions of s1 values not defined
#   by a G_ICMP and G_TRUNC s32->s1 could not be selected. (cmpdi2, addvdi3)
# RUN: llc -mtriple=m88k-unknown-none-elf -mcpu=mc88100 -global-isel -run-pass=instruction-select -verify-machineinstrs -o - %s | FileCheck %s
---
name:            brcond_ugt0
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: brcond_ugt0
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r2
  ; CHECK-NEXT:   BCND 13, [[COPY]], %bb.1
  ; CHECK-NEXT:   BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET
  bb.0:
    liveins: $r2
    %0:grrb(s32) = COPY $r2
    %1:grrb(s32) = G_CONSTANT i32 0
    %2:grrb(s1) = G_ICMP intpred(ugt), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.1
  bb.1:
    RET
...
