define void @alloca_nocall(i32 %n) {
; CHECK-LABEL: alloca_nocall:
; CHECK:       | %bb.0:
; CHECK-NEXT:    subu %r31, %r31, 16
; CHECK-NEXT:    st %r30, %r31, 0 | 4-byte Folded Spill
; CHECK-NEXT:    addu %r30, %r31, 0
; CHECK-NEXT:    addu %r2, %r2, 15
; CHECK-NEXT:    and %r2, %r2, 65520
; CHECK-NEXT:    addu %r2, %r2, 15
; CHECK-NEXT:    clr %r2, %r2, 4<0>
; CHECK-NEXT:    subu %r31, %r31, %r2
; CHECK-NEXT:    or %r2, %r31, %r0
; CHECK-NEXT:    or %r3, %r0, 1
; CHECK-NEXT:    st.b %r3, %r2, 0
; CHECK-NEXT:    subu %r31, %r30, 0
; CHECK-NEXT:    ld %r30, %r31, 0 | 4-byte Folded Reload
; CHECK-NEXT:    addu %r31, %r31, 16
; CHECK-NEXT:    jmp %r1
  %p = alloca i8, i32 %n
  store volatile i8 1, ptr %p
  ret void
}

