; VLA in a loop with stack save/restore.
define void @vla_loop(i32 %n) {
; CHECK-LABEL: vla_loop:
; CHECK:       | %bb.0: | %entry
; CHECK-NEXT:    subu %r31, %r31, 32
; CHECK-NEXT:    st %r1, %r31, 20 | 4-byte Folded Spill
; CHECK-NEXT:    st %r30, %r31, 16 | 4-byte Folded Spill
; CHECK-NEXT:    st.d %r24, %r31, 8 | 8-byte Folded Spill
; CHECK-NEXT:    st %r23, %r31, 4 | 4-byte Folded Spill
; CHECK-NEXT:    addu %r30, %r31, 16
; CHECK-NEXT:    or %r25, %r0, 0
; CHECK-NEXT:    addu %r2, %r2, 15
; CHECK-NEXT:    and %r24, %r2, 65520
; CHECK-NEXT:  .LBB2_1: | %loop
; CHECK-NEXT:    | =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    or %r23, %r0, %r31
; CHECK-NEXT:    addu %r2, %r24, 15
; CHECK-NEXT:    clr %r2, %r2, 4<0>
; CHECK-NEXT:    subu %r31, %r31, %r2
; CHECK-NEXT:    or %r2, %r31, %r0
; CHECK-NEXT:    bsr use
; CHECK-NEXT:    or %r31, %r0, %r23
; CHECK-NEXT:    addu %r25, %r25, 1
; CHECK-NEXT:    cmp %r2, %r25, 10
; CHECK-NEXT:    bb1 10, %r2, .LBB2_1
; CHECK-NEXT:  | %bb.2: | %exit
; CHECK-NEXT:    subu %r31, %r30, 16
; CHECK-NEXT:    ld %r23, %r31, 4 | 4-byte Folded Reload
; CHECK-NEXT:    ld.d %r24, %r31, 8 | 8-byte Folded Reload
; CHECK-NEXT:    ld %r30, %r31, 16 | 4-byte Folded Reload
; CHECK-NEXT:    ld %r1, %r31, 20 | 4-byte Folded Reload
; CHECK-NEXT:    addu %r31, %r31, 32
; CHECK-NEXT:    jmp %r1
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %inc, %loop ]
  %s = call ptr @llvm.stacksave.p0()
  %p = alloca i8, i32 %n
  call void @use(ptr %p)
  call void @llvm.stackrestore.p0(ptr %s)
  %inc = add i32 %i, 1
  %c = icmp ult i32 %inc, 10
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

