; CHECK-NEXT:    or %r12, %r0, %r25
; CHECK-NEXT:    or %r7, %r0, 0
; CHECK-NEXT:    or %r6, %r0, 0
; CHECK-NEXT:    or %r9, %r0, 1
; CHECK-NEXT:    or %r8, %r0, 0
; CHECK-NEXT:    bsr ret128
; CHECK-NEXT:    ld %r3, %r25, 12
; CHECK-NEXT:    ld %r2, %r25, 8
; CHECK-NEXT:    ld %r25, %r31, 12 | 4-byte Folded Reload
