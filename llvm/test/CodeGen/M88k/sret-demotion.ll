define { double, double } @retdd(double %a, double %b) {
; CHECK-LABEL: retdd:
; CHECK:       | %bb.0:
; CHECK-NEXT:    | kill: def $r3 killed $r3 killed $r2_r3 def $r2_r3
; CHECK-NEXT:    | kill: def $r2 killed $r2 killed $r2_r3 def $r2_r3
; CHECK-NEXT:    | kill: def $r5 killed $r5 killed $r4_r5 def $r4_r5
; CHECK-NEXT:    | kill: def $r4 killed $r4 killed $r4_r5 def $r4_r5
; CHECK-NEXT:    st.d %r2, %r12, 0
; CHECK-NEXT:    st.d %r4, %r12, 8
; CHECK-NEXT:    jmp %r1
  %1 = insertvalue { double, double } undef, double %a, 0
  %2 = insertvalue { double, double } %1, double %b, 1
  ret { double, double } %2
}

