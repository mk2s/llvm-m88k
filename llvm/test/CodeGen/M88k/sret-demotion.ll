define i128 @ret128(i128 %a, i128 %b) {
; CHECK-LABEL: ret128:
; CHECK:       | %bb.0:
; CHECK-NEXT:    addu.co %r5, %r5, %r9
; CHECK-NEXT:    addu.cio %r4, %r4, %r8
; CHECK-NEXT:    addu.cio %r3, %r3, %r7
; CHECK-NEXT:    addu.ci %r2, %r2, %r6
; CHECK-NEXT:    st %r5, %r12, 12
; CHECK-NEXT:    st %r4, %r12, 8
; CHECK-NEXT:    st %r3, %r12, 4
; CHECK-NEXT:    st %r2, %r12, 0
; CHECK-NEXT:    jmp %r1
  %r = add i128 %a, %b
  ret i128 %r
}

