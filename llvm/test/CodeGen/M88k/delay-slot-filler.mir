# RUN: llc -mtriple=m88k -global-isel -run-pass=m88k-delay-slot-filler -verify-machineinstrs -o - %s | FileCheck %s
---
name:            f1
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3

    renamable $r4 = CMPrr renamable $r2, renamable $r3
    BB1 2, killed renamable $r4, %bb.2
    ; There is no instruction for the delay slot.
    ; CHECK: BB1 2, killed renamable $r4, %bb.2

  bb.1:
    liveins: $r1, $r2, $r3

    renamable $r2 = ANDrr killed renamable $r2, killed renamable $r3
    ; CHECK-NOT: renamable $r2 = ANDrr killed renamable $r2, killed renamable $r3
    JMP $r1, implicit $r2
    ; The ANDrr moves into the delay slot.
    ; CHECK:      JMPn $r1, implicit $r2 {
    ; CHECK-NEXT:   renamable $r2 = ANDrr killed renamable $r2, killed renamable $r3
    ; CHECK-NEXT: }

  bb.2:
    liveins: $r1, $r2, $r3

    renamable $r2 = ORrr killed renamable $r2, killed renamable $r3
    ; CHECK-NOT: renamable $r2 = ORrr killed renamable $r2, killed renamable $r3
    JMP $r1, implicit $r2
    ; The ORrr moves into the delay slot.
    ; CHECK:      JMPn $r1, implicit $r2 {
    ; CHECK-NEXT:   renamable $r2 = ORrr killed renamable $r2, killed renamable $r3
    ; CHECK-NEXT: }
...
---
name:            f2
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    renamable $r2 = ADDUrr renamable $r3, killed renamable $r2

  bb.1:
    liveins: $r1, $r2, $r3

    renamable $r2 = SUBUrr killed renamable $r2, renamable $r3
    renamable $r4 = CMPrr renamable $r2, renamable $r3
    BB1 4, killed renamable $r4, %bb.1
    ; There is no instruction for the delay slot.
    ; CHECK: BB1 4, killed renamable $r4, %bb.1

  bb.2:
    liveins: $r1, $r2

    JMP $r1, implicit $r2
    ; There is no instruction for the delay slot.
    ; CHECK: JMP $r1, implicit $r2
...
---
name:            f3
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    renamable $r2 = ADDUrr renamable $r3, killed renamable $r2

  bb.1:
    liveins: $r1, $r2, $r3

    renamable $r2 = SUBUrr killed renamable $r2, renamable $r3
    renamable $r4 = CMPrr renamable $r2, renamable $r3
    BB1 4, killed renamable $r4, %bb.1
    ; There is no instruction for the delay slot.
    ; CHECK: BB1 4, killed renamable $r4, %bb.1

  bb.2:
    liveins: $r1, $r2

    renamable $r2 = ADDUri killed renamable $r2, 42
    ; CHECK-NOT: renamable $r2 = ADDUri killed renamable $r2, 42
    JMP $r1, implicit $r2
    ; The ADDUri moves into the delay slot.
    ; CHECK:      JMPn $r1, implicit $r2 {
    ; CHECK-NEXT:   renamable $r2 = ADDUri killed renamable $r2, 42
    ; CHECK-NEXT: }
...
---
name:            f4
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    renamable $r4 = ORri $r0, 0

  bb.1:
    liveins: $r1, $r2, $r3, $r4

    renamable $r4 = nuw ADDUri killed renamable $r4, 1
    ; CHECK-NOT: renamable $r4 = nuw ADDUri killed renamable $r4, 1
    renamable $r2 = SUBUrr killed renamable $r2, renamable $r3
    renamable $r5 = CMPrr renamable $r2, renamable $r3
    BB1 4, killed renamable $r5, %bb.1
    ; The ADDUri moves into the delay slot.
    ; CHECK:      BB1n 4, killed renamable $r5, %bb.1 {
    ; CHECK-NEXT:   renamable $r4 = nuw ADDUri killed renamable $r4, 1
    ; CHECK-NEXT: }

  bb.2:
    liveins: $r1, $r4

    $r2 = ORrr $r0, killed $r4
    ; CHECK-NOT: $r2 = ORrr $r0, killed $r4
    JMP $r1, implicit $r2
    ; The ORrr moves into the delay slot.
    ; CHECK:      JMPn $r1, implicit $r2 {
    ; CHECK-NEXT:   $r2 = ORrr $r0, killed $r4
    ; CHECK-NEXT: }
...
---
name:            f5
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2

    ; Non-ABI compliant. Check that a call can't move into the delay slot.
    JSR killed renamable $r2
    JMP $r1
    ; CHECK: JSR killed renamable $r2
    ; CHECK-NEXT: JMP $r1
...
---
name:            f6
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2

    ; Non-ABI compliant. Check that loading of return address does not move into
    ; delay slot.
    $r1 = ORrr $r0, killed $r2
    JMP $r1
    ; CHECK:      $r1 = ORrr $r0, killed $r2
    ; CHECK-NEXT: JMP $r1
...
---
name:            f7
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r3' }
  - { reg: '$r2' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    ; Non-ABI compliant. Check that loading of target address does not move into
    ; delay slot.
    $r1 = LDAws killed $r2, killed $r3
    JMP $r1
    ; CHECK:      $r1 = LDAws killed $r2, killed $r3
    ; CHECK-NEXT: JMP $r1
...
---
# The addu.co defines the CARRY bit which the following addu.ci uses
# implicitly. Moving the addu.co into the delay slot of the branch would
# compute the addu.ci with a stale carry (miscompiled uvm_map_findspace()
# in the NetBSD kernel).
name:            carry
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3

    renamable $r7 = ADDUrrco renamable $r2, renamable $r3, implicit-def $carry
    renamable $r8 = ADDUrrci $r0, $r0, implicit $carry
    BB1 0, killed renamable $r8, %bb.2
    ; The addu.co must stay before the addu.ci.
    ; CHECK:      renamable $r7 = ADDUrrco renamable $r2, renamable $r3, implicit-def $carry
    ; CHECK-NEXT: renamable $r8 = ADDUrrci $r0, $r0, implicit $carry
    ; CHECK-NEXT: BB1 0, killed renamable $r8, %bb.2

  bb.1:
    liveins: $r1, $r7

    $r2 = ORrr $r0, killed $r7
    JMP $r1, implicit $r2

  bb.2:
    liveins: $r1

    $r2 = ORri $r0, 0
    JMP $r1, implicit $r2
...
---
# CFI directives are skipped when searching a filler, so the code does not
# depend on whether CFI is emitted. A frame setup instruction moved into the
# delay slot takes the CFI directives which describe its effect along: they
# move behind the delay slot, which is the start of the layout successor if the
# instruction with the delay slot is a terminator.
name:            cfi
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r1' }
  - { reg: '$r30' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r30

    $r31 = frame-setup SUBUri $r31, 16
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    frame-setup STriw killed $r30, $r31, 0
    frame-setup CFI_INSTRUCTION offset $r30, -16
    $r30 = frame-setup ADDUri $r31, 0
    frame-setup CFI_INSTRUCTION def_cfa $r30, 16
    BB1 0, renamable $r2, %bb.2
    ; CHECK:      frame-setup STriw killed $r30, $r31, 0
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION offset $r30, -16
    ; CHECK-NEXT: BB1n 0, renamable $r2, %bb.2 {
    ; CHECK-NEXT:   $r30 = frame-setup ADDUri $r31, 0
    ; CHECK-NEXT: }
    ; CHECK:      bb.1:
    ; CHECK-NEXT: liveins: $r1
    ; CHECK-NOT:  {{^ *}}$r2
    ; CHECK:      frame-setup CFI_INSTRUCTION def_cfa $r30, 16
    ; CHECK-NEXT: JMPn $r1, implicit $r2 {
    ; CHECK-NEXT:   $r2 = ORri $r0, 1

  bb.1:
    liveins: $r1

    $r2 = ORri $r0, 1
    JMP $r1, implicit $r2

  bb.2:
    liveins: $r1

    $r2 = ORri $r0, 0
    JMP $r1, implicit $r2
...
---
# A CFI directive between a non frame setup filler and the branch stays where
# it is.
name:            cfi-body
alignment:       4
legalized:       true
regBankSelected: true
selected:        true
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r2' }
  - { reg: '$r3' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    renamable $r2 = ORrr killed renamable $r2, killed renamable $r3
    CFI_INSTRUCTION def_cfa_offset 0
    JMP $r1, implicit $r2
    ; CHECK:      CFI_INSTRUCTION def_cfa_offset 0
    ; CHECK-NEXT: JMPn $r1, implicit $r2 {
    ; CHECK-NEXT:   renamable $r2 = ORrr killed renamable $r2, killed renamable $r3
    ; CHECK-NEXT: }
...
