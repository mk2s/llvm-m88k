; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; Test @llvm.ctlz.* instrinsic.
;
; Regression (NCD 19c bring-up, found running compiler-rt in MAME): the
; zero-defined ctlz was lowered to ff1 / subu.co / addu.ci, assuming that the
; carry of a subtract is the borrow. On the M88k it is the inverted borrow, so
; the result was off by one (and compiler-rt __udivdi3(~0, 1) returned 0).
;
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88100 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88110 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s

declare i32 @llvm.ctlz.i32(i32, i1)

define i32 @f1(i32 %x) {
; CHECK-LABEL: f1:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ff1 %r2, %r2
; CHECK-NEXT:    xor %r3, %r2, 31
; CHECK-NEXT:    ext %r2, %r2, 1<5>
; CHECK-NEXT:    mask %r2, %r2, 31
; CHECK-NEXT:    xor %r2, %r3, %r2
; CHECK-NEXT:    jmp %r1
  %res = call i32 @llvm.ctlz.i32(i32 %x, i1 false)
  ret i32 %res
}

define i32 @f2(i32 %x) {
; CHECK-LABEL: f2:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ff1 %r2, %r2
; CHECK-NEXT:    xor %r2, %r2, 31
; CHECK-NEXT:    jmp %r1
  %res = call i32 @llvm.ctlz.i32(i32 %x, i1 true)
  ret i32 %res
}

define i32 @f3(i32 %x) {
; CHECK-LABEL: f3:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ff1 %r2, %r2
; CHECK-NEXT:    jmp %r1
  %cnt = call i32 @llvm.ctlz.i32(i32 %x, i1 true)
  %res = sub i32 31, %cnt
  ret i32 %res
}

define i32 @f4(i32 %x) {
; CHECK-LABEL: f4:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ff1 %r2, %r2
; CHECK-NEXT:    jmp %r1
  %cnt = call i32 @llvm.ctlz.i32(i32 %x, i1 true)
  %res = xor i32 %cnt, 31
  ret i32 %res
}
