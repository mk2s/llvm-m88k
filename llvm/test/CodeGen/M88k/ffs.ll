; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; Test the M88kFFS pass (x ? cttz(x) + 1 : 0 -> ff1).
;
; Regression (found running compiler-rt's ffssi2_test in MAME): the pass
; produced ff1(2 * (x & -x) + (x != 0)). ff1 returns 32 for an input of 0, so
; ffs(0) was 32 instead of 0, and for x == 0x80000000 the multiplication
; overflowed, so ffs(0x80000000) was 0 instead of 32. The result is now
; (ff1(x & -x) + 1) & ((ff1 >> 5) - 1).
;
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88100 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88110 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s
declare i32 @llvm.cttz.i32(i32, i1)

define i32 @ffs(i32 %a) {
; CHECK-LABEL: ffs:
; CHECK:       | %bb.0:
; CHECK-NEXT:    subu %r3, %r0, %r2
; CHECK-NEXT:    and %r2, %r2, %r3
; CHECK-NEXT:    ff1 %r2, %r2
; CHECK-NEXT:    addu %r3, %r2, 1
; CHECK-NEXT:    extu %r2, %r2, 0<5>
; CHECK-NEXT:    subu %r2, %r2, 1
; CHECK-NEXT:    and %r2, %r3, %r2
; CHECK-NEXT:    jmp %r1
  %iszero = icmp eq i32 %a, 0
  %c = tail call i32 @llvm.cttz.i32(i32 %a, i1 true)
  %add = add nuw nsw i32 %c, 1
  %r = select i1 %iszero, i32 0, i32 %add
  ret i32 %r
}
