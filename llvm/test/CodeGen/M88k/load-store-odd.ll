; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; Loads and stores whose memory size is not a power of 2 are split. On a
; big-endian target the part at the lower address holds the high bits:
; i52 is stored as 7 bytes, the 4 bytes at offset 0 are bits 55..24, the
; 3 bytes at offset 4 (st.h at 4, st.b at 6) bits 23..0. Generic GlobalISel used
; the little-endian order for stores and could not split loads on big-endian.
;
; RUN: llc < %s -mtriple=m88k-openbsd -mcpu=mc88100 -m88k-enable-delay-slot-filler=false -verify-machineinstrs | FileCheck %s

define void @store52(ptr %p, i52 %v) {
; CHECK-LABEL: store52:
; CHECK:       | %bb.0:
; CHECK-NEXT:    and %r3, %r5, 65535
; CHECK-NEXT:    extu %r5, %r3, 0<24>
; CHECK-NEXT:    mak %r4, %r4, 20<8>
; CHECK-NEXT:    or %r4, %r5, %r4
; CHECK-NEXT:    st %r4, %r2, 0
; CHECK-NEXT:    extu %r4, %r3, 0<8>
; CHECK-NEXT:    st.h %r4, %r2, 4
; CHECK-NEXT:    st.b %r3, %r2, 6
; CHECK-NEXT:    jmp %r1
  store i52 %v, ptr %p, align 8
  ret void
}

define i64 @load52(ptr %p) {
; CHECK-LABEL: load52:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ld %r3, %r2, 0
; CHECK-NEXT:    ld.hu %r4, %r2, 4
; CHECK-NEXT:    ld.bu %r2, %r2, 6
; CHECK-NEXT:    mak %r4, %r4, 0<8>
; CHECK-NEXT:    or %r2, %r4, %r2
; CHECK-NEXT:    mak %r4, %r3, 0<24>
; CHECK-NEXT:    mak %r5, %r2, 0<24>
; CHECK-NEXT:    extu %r3, %r3, 0<8>
; CHECK-NEXT:    or %r5, %r5, %r3
; CHECK-NEXT:    or %r2, %r4, %r2
; CHECK-NEXT:    and %r3, %r2, 65535
; CHECK-NEXT:    and.u %r2, %r5, 15
; CHECK-NEXT:    jmp %r1
  %v = load i52, ptr %p, align 8
  %z = zext i52 %v to i64
  ret i64 %z
}

define i64 @sload52(ptr %p) {
; CHECK-LABEL: sload52:
; CHECK:       | %bb.0:
; CHECK-NEXT:    ld %r3, %r2, 0
; CHECK-NEXT:    ld.hu %r4, %r2, 4
; CHECK-NEXT:    ld.bu %r2, %r2, 6
; CHECK-NEXT:    mak %r4, %r4, 0<8>
; CHECK-NEXT:    or %r2, %r4, %r2
; CHECK-NEXT:    mak %r4, %r3, 0<24>
; CHECK-NEXT:    mak %r5, %r2, 0<24>
; CHECK-NEXT:    extu %r3, %r3, 0<8>
; CHECK-NEXT:    or %r5, %r5, %r3
; CHECK-NEXT:    or %r3, %r4, %r2
; CHECK-NEXT:    ext %r2, %r5, 20<0>
; CHECK-NEXT:    jmp %r1
  %v = load i52, ptr %p, align 8
  %z = sext i52 %v to i64
  ret i64 %z
}
